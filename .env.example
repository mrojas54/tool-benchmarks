# Created with `npx lmnr-cli setup`; keep the real value only in gitignored .env.
LMNR_PROJECT_API_KEY=

# --- tools/llm_extraction.py: provider is picked from whichever of these is set ---
# OPENAI_BASE_URL wins (Ollama, vLLM or any OpenAI-compatible server); then
# ANTHROPIC_API_KEY, then GOOGLE_API_KEY / GEMINI_API_KEY, then OPENAI_API_KEY.
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Test gates (set to 1 to run; unset skips) ---
# External-oracle hermes test (see EVALUATION.md).
TOOLBENCH_LIVE=
# Slow corpus test; needs the vendored corpus.
TOOLBENCH_CORPUS_TESTS=

# Hermes archive root; overrides the default location (used by tests and non-default installs).
HERMES_HOME=
