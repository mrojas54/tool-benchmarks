# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# Session / memory artifacts
.remember/

# Codex machine-local tooling config (autogenerated)
.codex/

# Generated probe/report output (S16 keeps this separate from tools/ inputs)
reports/

# Lattice: the board is committed state. Ignore only machine-local runtime.
.lattice/locks/
.lattice/tmp-prompts/

# Serena: per-machine project cache, memories, and local config.
.serena/

# Complex-probe corpora: reproduce with corpus/vendor.sh (pinned SHAs in the
# packaged manifest, src/toolbench/corpus/manifest.json; vendor.sh copies it
# into corpus/ so the vendored tree is self-describing)
corpus/*/
corpus/manifest.json
# roborev snapshots
/.roborev/
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# Riptide artifacts (cloud-synced)
.humanlayer/tasks/
# machine-local workspace overrides; .humanlayer/workspace.json IS committed
.humanlayer/workspace.local.json

# Linked git worktrees created by agent tooling: machine-local checkouts,
# never committed state. Previously suppressed only by .git/info/exclude,
# which no clone inherits.
.claude/worktrees/
